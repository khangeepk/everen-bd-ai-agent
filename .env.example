# ---------------------------------------------------------------------------
# Everen BD Agent - environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# App
APP_ENV=development                 # development | staging | production
SECRET_KEY=CHANGE_ME
LOG_LEVEL=INFO

# PII encryption at rest (contact_email/contact_phone and similar columns).
# The default is a fixed, publicly-known dev-only placeholder. Generate a
# real one before storing any real person's data:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=E25xTJVA9vjWAdMy7inb-JtYfT_0u3pkfK15juhxPt8=

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/everen_db

# Redis
REDIS_URL=redis://localhost:6379/0

# AI / LLM
OPENAI_API_KEY=sk-REPLACE_ME
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RECOMMENDATION_MODEL=gpt-4o-mini

# Website audit (PageSpeed Insights / Lighthouse)
PAGESPEED_API_KEY=REPLACE_ME
# Crawl bounds for broken-link checking on third-party sites. Keep these low.
AUDIT_CRAWL_MAX_PAGES=25
AUDIT_CRAWL_MAX_DEPTH=2
AUDIT_CRAWL_DELAY_SECONDS=1.0

# Lead scoring - deal-size range for normalizing the Revenue component
LEAD_SCORE_REVENUE_SCALE_MIN=5000.0
LEAD_SCORE_REVENUE_SCALE_MAX=180000.0

# Google Places (lead discovery)
# Only place_id (indefinite) and lat/lng (30 days max) may be stored from this
# API. See app/services/places_policy.py.
GOOGLE_PLACES_API_KEY=REPLACE_ME
PLACES_COORDINATE_TTL_DAYS=30

# API cost guard - daily budget caps + 80% alert (app/services/cost_guard.py)
COST_GUARD_DAILY_BUDGET_PLACES_USD=20.0
COST_GUARD_DAILY_BUDGET_OPENAI_USD=20.0
COST_GUARD_ALERT_THRESHOLD=0.8

# Auth (JWKS-based verification - works with Clerk or Auth.js)
# Clerk:   AUTH_JWKS_URL=https://<your-app>.clerk.accounts.dev/.well-known/jwks.json
#          AUTH_ISSUER=https://<your-app>.clerk.accounts.dev
# Auth.js: point at your Next.js JWKS route and its issuer.
AUTH_JWKS_URL=https://REPLACE_ME/.well-known/jwks.json
AUTH_ISSUER=https://REPLACE_ME
AUTH_AUDIENCE=everen-bd-agent
AUTH_ALGORITHMS=RS256
AUTH_JWKS_CACHE_SECONDS=3600

# Email / Outreach (human-gated - see AGENTS.md 8)
SENDGRID_API_KEY=SG.REPLACE_ME
OUTREACH_FROM_EMAIL=bd@yourdomain.com
OUTREACH_FROM_NAME=Everen Techno
OUTREACH_REPLY_TO=
OUTREACH_COMPANY_NAME=Everen Techno
# REQUIRED by CAN-SPAM in every commercial email. Must be a real street
# address, a USPS-registered PO Box, or a registered private mailbox.
# Drafting fails while this is left as REPLACE_ME.
OUTREACH_PHYSICAL_ADDRESS=REPLACE_ME
# Public base URL for one-click unsubscribe links.
OUTREACH_PUBLIC_BASE_URL=https://REPLACE_ME
# Daily send cap per channel (deliverability + blast-radius control).
OUTREACH_DAILY_SEND_LIMIT=50

# Deliverability checklist (SPF/DKIM/DMARC + warmup + readiness report)
# Leave blank to default to the domain half of OUTREACH_FROM_EMAIL.
DELIVERABILITY_CHECK_DOMAIN=
# Best-effort DKIM selector guesses -- override if SendGrid's domain
# authentication setup shows different selectors than its own s1/s2 defaults.
SENDGRID_DKIM_SELECTORS=s1,s2

# Calendar booking - single shared sales calendar (one Google account's OAuth
# refresh token, obtained once by an admin outside this app via a manual
# consent flow for the https://www.googleapis.com/auth/calendar scope, e.g.
# Google's OAuth Playground) -- not a per-rep "connect your calendar" flow.
GOOGLE_CALENDAR_CLIENT_ID=REPLACE_ME
GOOGLE_CALENDAR_CLIENT_SECRET=REPLACE_ME
GOOGLE_CALENDAR_REFRESH_TOKEN=REPLACE_ME
# "primary" uses that account's own calendar; set to a specific calendar id
# to use a dedicated shared calendar instead.
GOOGLE_CALENDAR_ID=primary
BOOKING_TIMEZONE=America/Chicago
BOOKING_SLOT_DURATION_MINUTES=30
BOOKING_WORKING_HOUR_START=9
BOOKING_WORKING_HOUR_END=17
BOOKING_LOOKAHEAD_DAYS=10
BOOKING_MIN_LEAD_TIME_MINUTES=60
BOOKING_LINK_EXPIRY_DAYS=21

# CORS - explicit allowlist, never "*" in production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# n8n SendGrid health-monitor webhook authentication
# Shared secret validated by app/api/deps.verify_webhook_secret on
# POST /api/v1/outreach/pause. Leave blank in local dev (auth disabled).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_WEBHOOK_SECRET=REPLACE_ME_WITH_A_STRONG_RANDOM_SECRET

# Languages the LLM may draft in (BCP-47, comma-separated).
# Detected languages not in this list fall back to English with a warning.
OUTREACH_SUPPORTED_LANGUAGES=en,es,fr,de,pt,ar,zh,ja,ko,it,nl,ru,hi
