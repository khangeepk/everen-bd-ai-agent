# Copy to .env.local for local development.
#
# Used by the dashboard chat panel (src/components/dashboard/ChatPanel.tsx),
# the first real API wiring in this frontend -- everything else still renders
# mock data only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Every backend route requires a verified JWT (Clerk/Auth.js JWKS -- see
# backend/app/api/deps.py::get_current_user). This frontend has no sign-in
# flow yet, so set this to a token obtained separately (e.g. from a
# Clerk/Auth.js session) to let the chat panel make real API calls locally.
# Leave unset to always use the panel's mock fallback instead.
NEXT_PUBLIC_DEV_API_TOKEN=

# Also required for real calls to succeed from a browser: the backend's
# CORS_ORIGINS setting (backend/.env, see backend/app/core/config.py) must
# include this frontend's origin, e.g. CORS_ORIGINS=http://localhost:3000.
