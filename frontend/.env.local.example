# Copy to .env.local for local development.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# You do NOT need to set anything for auth anymore. The frontend
# automatically requests a short-lived local dev session from the backend
# (POST /api/v1/dev/session -- see backend/app/api/v1/dev_auth.py and
# backend/app/core/dev_auth.py) the first time it needs to call a protected
# endpoint. That endpoint always 404s when the backend's APP_ENV=production,
# so this is a genuine no-op against anything but a local/dev backend.
#
# NEXT_PUBLIC_DEV_API_TOKEN below is now an OPTIONAL override -- only set it
# if you specifically want to bypass the dev-session flow (e.g. testing with
# a real Clerk/Auth.js token against a backend that has real
# AUTH_JWKS_URL/AUTH_ISSUER/AUTH_AUDIENCE configured). Leave it blank for
# normal local development.
NEXT_PUBLIC_DEV_API_TOKEN=

# Also required for real calls to succeed from a browser: the backend's
# CORS_ORIGINS setting (backend/.env, see backend/app/core/config.py) must
# include this frontend's origin. http://localhost:3000 is already in the
# default, so nothing to do unless you changed the frontend's port.
