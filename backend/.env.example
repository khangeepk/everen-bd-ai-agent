# Copy this file to `.env` and fill in real values. `.env` itself is
# gitignored and must never be committed -- see AGENTS.md section 5 /
# CLAUDE.md. Settings are loaded by app/core/config.py; nothing else in this
# codebase may read os.environ directly.

# --- App ---
APP_ENV=development
SECRET_KEY=CHANGE_ME
LOG_LEVEL=INFO

# --- PII encryption at rest (app/db/types.py EncryptedString) ---
# The value below is a fixed, publicly-known dev-only placeholder. Generate a
# real key before storing any real person's data:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=E25xTJVA9vjWAdMy7inb-JtYfT_0u3pkfK15juhxPt8=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/everen_db

# --- Redis (Celery broker/result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- AI / LLM ---
OPENAI_API_KEY=sk-REPLACE_ME
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RECOMMENDATION_MODEL=gpt-4o-mini

# --- Website audit ---
PAGESPEED_API_KEY=REPLACE_ME
AUDIT_CRAWL_MAX_PAGES=25
AUDIT_CRAWL_MAX_DEPTH=2
AUDIT_CRAWL_DELAY_SECONDS=1.0

# --- Lead scoring ---
LEAD_SCORE_REVENUE_SCALE_MIN=5000.0
LEAD_SCORE_REVENUE_SCALE_MAX=180000.0

# --- Google Places (lead discovery) ---
GOOGLE_PLACES_API_KEY=REPLACE_ME
PLACES_COORDINATE_TTL_DAYS=30
# Soft-launch/dev safety rail: caps total Places API requests for the life of
# the process, independent of the dollar-based cost guard below. Turn on
# during test batches to keep a run trivially inside Google Maps Platform's
# monthly free credit.
PLACES_TEST_MODE=false
PLACES_TEST_MODE_MAX_REQUESTS=10

# --- API cost guard (daily budget cap + 80% alert) ---
COST_GUARD_DAILY_BUDGET_PLACES_USD=20.0
COST_GUARD_DAILY_BUDGET_OPENAI_USD=20.0
COST_GUARD_ALERT_THRESHOLD=0.8

# --- Auth (Clerk / Auth.js JWKS) ---
AUTH_JWKS_URL=https://REPLACE_ME/.well-known/jwks.json
AUTH_ISSUER=https://REPLACE_ME
AUTH_AUDIENCE=everen-bd-agent
AUTH_ALGORITHMS=RS256
AUTH_JWKS_CACHE_SECONDS=3600

# --- Email / Outreach (human-gated -- AGENTS.md section 8) ---
SENDGRID_API_KEY=SG.REPLACE_ME
# Set true only for a deliberate test/soft-launch window: SendGrid validates
# and accepts every send (so approval/suppression/quota/CAN-SPAM checks all
# run for real) but never actually delivers the message. Must be false (the
# default) before any real send is intended.
SENDGRID_SANDBOX_MODE=false
OUTREACH_FROM_EMAIL=bd@yourdomain.com
OUTREACH_FROM_NAME=Everen Techno
OUTREACH_REPLY_TO=
OUTREACH_COMPANY_NAME=Everen Techno
# REQUIRED by CAN-SPAM: a real street address, USPS PO Box, or registered
# private mailbox. Draft generation 422s until this is a real address.
OUTREACH_PHYSICAL_ADDRESS=REPLACE_ME
OUTREACH_PUBLIC_BASE_URL=https://REPLACE_ME
OUTREACH_DAILY_SEND_LIMIT=50

# --- Deliverability checklist (SPF/DKIM/DMARC + warmup + readiness report) ---
# Domain the deliverability checker inspects. Leave blank to default to the
# domain half of OUTREACH_FROM_EMAIL.
DELIVERABILITY_CHECK_DOMAIN=
# Best-effort DKIM selector guesses -- there is no way to discover the real
# selector via DNS alone. Override with the selector(s) SendGrid's domain
# authentication setup shows if they differ from its own s1/s2 defaults.
SENDGRID_DKIM_SELECTORS=s1,s2

# --- Calendar booking (single shared sales calendar -- see app/services/
# google_calendar.py's module docstring for why this is one account's OAuth
# refresh token, obtained once outside this app, not a per-rep connect flow) ---
# Obtain by creating an OAuth client (Google Cloud Console -> APIs & Services
# -> Credentials) and completing one manual consent flow for the
# https://www.googleapis.com/auth/calendar scope (e.g. via Google's OAuth
# Playground) to get a refresh token for the account that owns the calendar.
GOOGLE_CALENDAR_CLIENT_ID=REPLACE_ME
GOOGLE_CALENDAR_CLIENT_SECRET=REPLACE_ME
GOOGLE_CALENDAR_REFRESH_TOKEN=REPLACE_ME
# "primary" uses that account's own calendar; set to a specific calendar id
# to use a dedicated shared calendar instead.
GOOGLE_CALENDAR_ID=primary
BOOKING_TIMEZONE=America/Chicago
BOOKING_SLOT_DURATION_MINUTES=30
BOOKING_WORKING_HOUR_START=9
BOOKING_WORKING_HOUR_END=17
BOOKING_LOOKAHEAD_DAYS=10
BOOKING_MIN_LEAD_TIME_MINUTES=60
BOOKING_LINK_EXPIRY_DAYS=21

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Error alerting (Sentry, Phase E) ---
# Leave blank to disable entirely (default / safe for local dev). Get a DSN
# by creating a free project at sentry.io -- see DEPLOYMENT.md.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- n8n SendGrid health-monitor webhook authentication ---
# Shared secret validated by app/api/deps.verify_webhook_secret on
# POST /api/v1/outreach/pause. Leave blank in local dev (auth disabled).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_WEBHOOK_SECRET=REPLACE_ME_WITH_A_STRONG_RANDOM_SECRET

# Languages the LLM may draft in (BCP-47, comma-separated).
# Detected languages not in this list fall back to English with a warning.
OUTREACH_SUPPORTED_LANGUAGES=en,es,fr,de,pt,ar,zh,ja,ko,it,nl,ru,hi
